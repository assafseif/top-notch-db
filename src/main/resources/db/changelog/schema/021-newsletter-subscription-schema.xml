<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="021-create-newsletter-subscription-table" author="copilot">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="newsletter_subscription" schemaName="dbo"/>
            </not>
        </preConditions>

        <createTable tableName="newsletter_subscription" schemaName="dbo">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_newsletter_subscription" nullable="false"/>
            </column>
            <column name="email" type="NVARCHAR(320)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_newsletter_subscription_email"/>
            </column>
            <column name="created_at" type="DATETIME2">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>